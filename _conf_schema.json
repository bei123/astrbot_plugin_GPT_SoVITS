{
    "enabled": {
        "description": "总开关",
        "type": "bool",
        "hint": "GPT-SoVITS 插件总开关，请在部署好 GPT-SoVITS 后再打开此开关",
        "default": true
    },
    "auto": {
        "description": "调用配置",
        "type": "object",
        "hint": "本插件有一定概率主动将bot本来要发送的文本转成语音发送",
        "items": {
            "only_llm_result": {
                "description": "只处理LLM结果",
                "type": "bool",
                "hint": "只处理 LLM 返回的消息。建议打开",
                "default": true
            },
            "tts_prob": {
                "description": "主动转语音发送的概率",
                "type": "float",
                "hint": "",
                "slider": {
                    "min": 0,
                    "max": 1,
                    "step": 0.01
                },
                "default": 0.15
            },
            "max_msg_len": {
                "description": "文本长度限制",
                "type": "int",
                "hint": "超过此长度的文本不会被转成语音发送",
                "slider": {
                    "min": 0,
                    "max": 200,
                    "step": 1
                },
                "default": 50
            }
        }
    },
    "client": {
        "description": "客户端配置",
        "type": "object",
        "hint": "",
        "items": {
            "base_url": {
                "description": "GPT-SoVITS API 的 URL",
                "type": "string",
                "hint": "必填！GPT_SoVITS官方整合包默认为 http://127.0.0.1:9880 ，第三方整合包可能不同",
                "default": "http://127.0.0.1:9880"
            },
            "timeout": {
                "description": "GPT-SoVITS API 请求超时时间",
                "hint": "单位为秒",
                "type": "int",
                "slider": {
                    "min": 30,
                    "max": 180,
                    "step": 1
                },
                "default": 60
            },
            "tts_endpoint": {
                "description": "TTS 请求路径",
                "type": "string",
                "hint": "官方接口填 /tts（GET）；若上游为 QQ 机器人专用接口则填 /qqbot（POST JSON：text, text_language, model_name）",
                "default": "/tts"
            },
            "say_command": {
                "description": "TTS 命令词",
                "type": "string",
                "hint": "用于触发「命令 + 内容」合成语音，如填「说」则使用「说 你好」",
                "default": "说"
            },
            "say_command_aliases": {
                "description": "TTS 命令别名",
                "type": "string",
                "hint": "逗号分隔，如 gsv,GSV，与命令词等效",
                "default": "gsv,GSV"
            }
        }
    },
    "model": {
        "description": "模型配置",
        "type": "object",
        "hint": "使用 QQ 机器人专用接口 (TTS 请求路径填 /qqbot) 时无需填写以下路径，由上游服务管理模型",
        "items": {
            "gpt_path": {
                "description": "GPT模型文件路径",
                "type": "string",
                "hint": "即“.ckpt”后缀的文件。使用 /qqbot 接口时可不填；否则不填则用 GPT_SoVITS 内置模型",
                "default": ""
            },
            "sovits_path": {
                "description": "SoVITS模型文件路径",
                "type": "string",
                "hint": "即“.pth”后缀的文件。使用 /qqbot 接口时可不填；否则不填则用 GPT_SoVITS 内置模型",
                "default": ""
            }
        }
    },
    "default_params": {
        "description": "TTS默认参数",
        "type": "object",
        "hint": "使用 /qqbot 接口时请在配置中填写：文本语言(text_lang)、model_name（text 由消息内容提供）。使用 /tts 时其余参数生效",
        "items": {
            "text": {
                "description": "要转换为语音的文本",
                "type": "string",
                "hint": "默认占位；实际合成时由消息内容填入。使用 /qqbot 时此字段会提交",
                "default": ""
            },
            "text_lang": {
                "description": "文本语言",
                "type": "string",
                "hint": "要转化的文本的语言。使用 /qqbot 时必填，会以 text_language 提交",
                "options": [
                    "zh",
                    "en",
                    "ja",
                    "ko"
                ],
                "labels": [
                    "中文",
                    "英语",
                    "日语",
                    "韩语"
                ],
                "default": "zh"
            },
            "model_name": {
                "description": "模型名称",
                "type": "string",
                "hint": "使用 /qqbot 接口时必填，与上游约定的模型名一致",
                "default": ""
            },
            "ref_audio_path": {
                "description": "参考音频路径",
                "type": "string",
                "hint": "用于音色克隆，支持 wav 格式。使用 /qqbot 接口时可不填",
                "default": ""
            },
            "prompt_text": {
                "description": "参考音频对应的文本",
                "type": "string",
                "hint": "用于对齐音色与内容。使用 /qqbot 接口时不生效",
                "default": "就算是这样，也不至于直接碎掉啊，除非"
            },
            "prompt_lang": {
                "description": "参考音频文本语言",
                "type": "string",
                "hint": "尽量与 prompt_text 语言一致。使用 /qqbot 接口时不生效",
                "options": [
                    "zh",
                    "en",
                    "ja",
                    "ko"
                ],
                "labels": [
                    "中文",
                    "英语",
                    "日语",
                    "韩语"
                ],
                "default": "zh"
            },
            "top_k": {
                "description": "Top-K 采样",
                "type": "int",
                "hint": "采样参数，控制随机性与稳定性。使用 /qqbot 接口时不生效",
                "slider": {
                    "min": 1,
                    "max": 20,
                    "step": 1
                },
                "default": 5
            },
            "top_p": {
                "description": "Top-P 核采样",
                "type": "float",
                "hint": "采样参数。使用 /qqbot 接口时不生效",
                "slider": {
                    "min": 0.1,
                    "max": 1.0,
                    "step": 0.01
                },
                "default": 1.0
            },
            "temperature": {
                "description": "采样温度",
                "type": "float",
                "hint": "采样参数。使用 /qqbot 接口时不生效",
                "slider": {
                    "min": 0.1,
                    "max": 2.0,
                    "step": 0.01
                },
                "default": 1.0
            },
            "text_split_method": {
                "description": "文本切分方式",
                "type": "string",
                "hint": "长文本与性能相关，按显存与效果微调。使用 /qqbot 接口时不生效",
                "options": [
                    "cut0",
                    "cut1",
                    "cut2",
                    "cut3",
                    "cut4",
                    "cut5"
                ],
                "labels": [
                    "不切分",
                    "四句一切",
                    "50字一切",
                    "按中文句号切",
                    "按英文句号切",
                    "按标点符号切"
                ],
                "default": "cut3"
            },
            "batch_size": {
                "description": "推理批大小",
                "type": "int",
                "hint": "长文本与性能相关。使用 /qqbot 接口时不生效",
                "slider": {
                    "min": 1,
                    "max": 5,
                    "step": 1
                },
                "default": 1
            },
            "batch_threshold": {
                "description": "批处理阈值",
                "type": "float",
                "hint": "长文本与性能相关。使用 /qqbot 接口时不生效",
                "slider": {
                    "min": 0.1,
                    "max": 1.0,
                    "step": 0.01
                },
                "default": 0.75
            },
            "split_bucket": {
                "description": "启用分桶推理",
                "type": "bool",
                "hint": "长文本与性能相关。使用 /qqbot 接口时不生效",
                "default": true
            },
            "speed_factor": {
                "description": "语速倍率",
                "type": "float",
                "hint": "1.0 为原速。使用 /qqbot 接口时不生效",
                "slider": {
                    "min": 0.5,
                    "max": 2.0,
                    "step": 0.1
                },
                "default": 1.0
            },
            "fragment_interval": {
                "description": "语句片段间隔(秒)",
                "type": "float",
                "hint": "值越小节奏越紧凑。使用 /qqbot 接口时不生效",
                "slider": {
                    "min": 0.1,
                    "max": 1.0,
                    "step": 0.01
                },
                "default": 0.3
            },
            "streaming_mode": {
                "description": "启用流式返回",
                "type": "bool",
                "hint": "长文本与性能相关。使用 /qqbot 接口时不生效",
                "default": false
            },
            "seed": {
                "description": "随机种子",
                "type": "int",
                "hint": "-1 为随机。使用 /qqbot 接口时不生效",
                "default": -1
            },
            "parallel_infer": {
                "description": "启用并行推理",
                "type": "bool",
                "hint": "长文本与性能相关。使用 /qqbot 接口时不生效",
                "default": true
            },
            "repetition_penalty": {
                "description": "重复惩罚系数",
                "type": "float",
                "hint": "越高越不容易重复。使用 /qqbot 接口时不生效",
                "slider": {
                    "min": 1.0,
                    "max": 3.0,
                    "step": 0.01
                },
                "default": 1.35
            },
            "media_type": {
                "description": "输出音频格式",
                "type": "string",
                "hint": "wav/mp3/ogg，建议 wav。使用 /qqbot 接口时不生效",
                "options": [
                    "wav",
                    "mp3",
                    "ogg"
                ],
                "default": "wav"
            }
        }
    },
    "judge": {
        "description": "LLM 配置（情绪判断）",
        "hint": "使用 /qqbot 接口时情绪功能不生效，无需配置",
        "type": "object",
        "items": {
            "enabled_llm": {
                "description": "使用 LLM 判断情感",
                "type": "bool",
                "hint": "开启后用 LLM 判断文本情绪以改变语音参数；关闭则用触发词匹配。使用 /qqbot 时不生效",
                "default": false
            },
            "provider_id": {
                "description": "判断情感用的 LLM 提供商",
                "type": "string",
                "default": "",
                "hint": "使用 /qqbot 时不生效",
                "_special": "select_provider"
            }
        }
    },
    "cache": {
        "description": "缓存配置",
        "type": "object",
        "hint": "",
        "items": {
            "enabled": {
                "description": "启用语音缓存",
                "hint": "开启后，请求参数一致时直接复用本地缓存音频，减少重复推理",
                "type": "bool",
                "default": true
            },
            "expire_hours": {
                "description": "缓存过期时间(h)",
                "hint": "单位为小时。 0 表示永不过期，大于 0 时按文件修改时间判断是否过期",
                "type": "int",
                "slider": {
                    "min": 0,
                    "max": 240,
                    "step": 1
                },
                "default": 0
            },
            "path": {
                "description": "缓存路径",
                "hint": "支持绝对路径和相对路径；留空时默认 data/plugins_data/astrbot_plugin_GPT_SoVITS/audio",
                "type": "string",
                "default": "data/plugins_data/astrbot_plugin_GPT_SoVITS/audio"
            }
        }
    },
    "entry_storage": {
        "description": "情绪参数配置",
        "hint": "可自定义多套情绪参数与触发词。使用 /qqbot 接口时不生效，无需配置",
        "type": "template_list",
        "templates": {
            "default": {
                "name": "情绪条目",
                "items": {
                    "name": {
                        "description": "情绪名",
                        "type": "string",
                        "hint": "用于查询与显示，请确保名称唯一",
                        "default": "请输入情绪名"
                    },
                    "keywords": {
                        "description": "触发词",
                        "type": "list",
                        "hint": "AI回复词中含有列表中的任一关键词时, 将使用此套的情绪参数",
                        "default": []
                    },
                    "ref_audio_path": {
                        "description": "参考音频文件路径",
                        "type": "string",
                        "hint": "支持绝对路径和相对路径，拼接时请使用“/”",
                        "default": ""
                    },
                    "prompt_text": {
                        "description": "参考音频对应的文本",
                        "type": "string",
                        "hint": "建议填写，用于对齐音色与内容",
                        "default": ""
                    },
                    "prompt_lang": {
                        "description": "参考音频文本语言",
                        "type": "string",
                        "hint": "与参考音频对应的文本的语言保持一致",
                        "options": [
                            "zh",
                            "en",
                            "ja",
                            "ko"
                        ],
                        "labels": [
                            "中文",
                            "英语",
                            "日语",
                            "韩语"
                        ],
                        "default": "zh"
                    },
                    "speed_factor": {
                        "description": "语速倍数",
                        "type": "float",
                        "hint": "1.0 为原速",
                        "slider": {
                            "min": 0.5,
                            "max": 2,
                            "step": 0.1
                        },
                        "default": 1
                    },
                    "fragment_interval": {
                        "description": "语音片段间隔（秒）",
                        "type": "float",
                        "hint": "间隔越短语气越急促",
                        "slider": {
                            "min": 0.1,
                            "max": 2,
                            "step": 0.1
                        },
                        "default": 0.7
                    }
                }
            }
        }
    }
}